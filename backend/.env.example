# CogniFlow 环境配置示例
# 用法：cp .env.example .env，然后把占位符换成真实值
# 千万不要把 .env 提交到 git（已在 .gitignore 中忽略）

# ---------- 密钥 ----------
# 阿里云百炼 / DashScope API Key（必填）
# 获取地址：https://bailian.console.aliyun.com/ → API-KEY 管理
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 模型 ----------
# 全局默认模型，三个业务 agent（售前/售中/售后）共用
QWEN_MODEL=qwen-max

# 意图分类 + 对话摘要用的模型；留空则复用 QWEN_MODEL
# 建议设为便宜的小模型以降低成本，例如 qwen-turbo
# INTENT_MODEL=qwen-turbo

# 单独覆盖某个 agent 的模型（可选，留空则复用 QWEN_MODEL）
# PRE_SALES_MODEL=
# DURING_SALES_MODEL=
# AFTER_SALES_MODEL=

# Embedding 模型（改这个会导致已有向量全部失效，必须重新 ingest）
EMBEDDING_MODEL=text-embedding-v3

# ---------- 接口地址 ----------
# 兼容模式 endpoint（默认值，通常不用改）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 数据库 ----------
# 不填则使用默认值 postgresql+asyncpg://postgres:postgres@localhost:5432/cogniflow
# DATABASE_URL=postgresql+asyncpg://postgres:你的密码@localhost:5432/cogniflow

# ---------- 缓存 ----------
# 不填则使用默认值 redis://localhost:6379/0；Redis 不可用时会自动回退到内存实现
# REDIS_URL=redis://localhost:6379/0
